				<key>ActionBundlePath</key>
				<string>/System/Library/Automator/Run Shell Script.action</string>
				<key>ActionName</key>
				<string>Run Shell Script</string>
				<key>ActionParameters</key>
				<dict>
					<key>COMMAND_STRING</key>
					<string># Obtain current xleda persistent settings
SETTINGS_FILE="$HOME/Library/Application Support/.xleda/settings.json"
TARGET_FILE=$(realpath "$1")

# Obtain current xleda Python executable location
if [ -f "$SETTINGS_FILE" ]; then
    PYTHON_EXE=$(python3 -c "import json, os; print(json.load(open(os.path.expanduser('$SETTINGS_FILE'))).get('python_executable', 'python3'))")
else
    PYTHON_EXE="python3"
fi

# Clear the terminal first, execute xleda, and hold the screen open
EXEC_CMD="clear; \"$PYTHON_EXE\" -m xleda wb \"$TARGET_FILE\"; echo; echo \"You can now close this window.\"; read -n 1 -s -r"

# Pass the clean string argument safely into the native Terminal app
/usr/bin/osascript -e 'on run argv' -e 'tell application "Terminal" to do script (item 1 of argv)' -e 'end run' -- "$EXEC_CMD"
</string>
					<key>CheckedForUserDefaultShell</key>
					<true/>
					<key>inputMethod</key>
					<integer>1</integer>
					<key>shell</key>
					<string>/bin/zsh</string>
					<key>source</key>
					<string></string>
				</dict>
